rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      // Check if authenticated user's email matches admin emails
      return request.auth != null && (
             request.auth.token.email == 'lebrockmaldonado@gmail.com' ||
             request.auth.token.email == 'contact@thepepplanner.com' ||
             request.auth.token.email == 'thepepplanner@gmail.com'
      );
    }
    
    // Users can only read/write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin(); // Admin can read user data for analytics
      // Email checking during login uses fetchSignInMethodsForEmail (Auth SDK, not Firestore)
      // so unauthenticated Firestore read is NOT needed. Removed open read rule.
      allow read: if request.auth != null; // Authenticated users can query by email for account checks
      allow write: if isAdmin(); // Admin can write to update user subscriptions (lifetime access)
    }
    
    // Users can only read/write their own encrypted data
    match /userdata/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Announcements - all users can read, admin can manage
    match /announcements/{announcementId} {
      allow read: if true; // All users can read announcements
      allow create, update, delete: if isAdmin(); // Only admin can manage announcements
    }
    
    // Analytics - admin only for privacy
    match /analytics/{document} {
      allow read, write: if isAdmin(); // Only admin can access analytics
    }
    
    // Feedback collection - users can submit, admin can read/manage
    match /feedback/{feedbackId} {
      allow create: if request.auth != null; // Authenticated users can submit feedback
      allow read, update, delete: if isAdmin(); // Only admin can read/manage feedback
    }
    
    // Support tickets - users can create and read their own, admin can read/write all
    match /supportTickets/{ticketId} {
      // Users create their own tickets; admins may open/link tickets on behalf of users (CRM)
      allow create: if request.auth != null && (
        request.resource.data.userEmail == request.auth.token.email ||
        isAdmin()
      );
      allow read: if request.auth != null && (
        request.auth.token.email == resource.data.userEmail ||
        isAdmin()
      );
      // Users may bump timestamps on their own tickets; status/ownership changes stay admin-only
      allow update: if isAdmin()
        || (
          request.auth != null
          && request.auth.token.email == resource.data.userEmail
          && request.resource.data.userEmail == resource.data.userEmail
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.status == resource.data.status
        );
      allow delete: if isAdmin();
      
      // Messages: users can only post as themselves on their own tickets (no forged admin replies)
      match /messages/{messageId} {
        allow create: if request.auth != null && (
          (
            request.resource.data.senderType == 'user'
            && request.resource.data.senderEmail == request.auth.token.email
            && get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.userEmail == request.auth.token.email
          )
          || (
            isAdmin()
            && request.resource.data.senderType in ['admin', 'user']
          )
        );
        allow read: if request.auth != null && (
          request.auth.token.email == get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.userEmail ||
          isAdmin()
        );
        allow update, delete: if isAdmin();
      }
    }
    
    // Admin messages - one-way messages from admin to users
    match /adminMessages/{messageId} {
      allow create: if isAdmin(); // Only admin can create messages (via function)
      // Allow reading - users can read their own messages, admin can read all
      // Note: Emails are stored in lowercase in database. Query filters by lowercase email.
      // Auth token email should match the stored lowercase email.
      allow read: if request.auth != null && (
        resource.data.userEmail == request.auth.token.email || // Users can read their own messages
        isAdmin() // Admin can read all messages
      );
      allow update: if request.auth != null && (
        resource.data.userEmail == request.auth.token.email || // Users can mark their own messages as read
        isAdmin() // Admin can update all messages
      );
      allow delete: if isAdmin(); // Only admin can delete messages
    }
    
    // Notifications - users can read/update their own notifications, admin can create
    match /notifications/{notificationId} {
      allow read, update, delete: if request.auth != null && 
        request.auth.token.email == resource.data.userEmail;
      allow create: if isAdmin(); // Only admin can create notifications
    }
    
    // User notification settings - users can manage their own settings
    match /userNotificationSettings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Removed overly broad fallback rule that let any authenticated user read/write any user's settings
    }
    
    // Push notification subscriptions (legacy) - FCM tokens now live on users/{userId}.
    // Nothing in the client reads/writes this collection anymore; Cloud Functions (Admin SDK,
    // bypasses rules) only delete leftover docs during account deletion.
    match /pushSubscriptions/{subscriptionId} {
      allow read, write: if false;
    }
    
    // ===== CLOUD STORAGE COLLECTIONS (CRITICAL SECURITY) =====
    // Users can ONLY access their own data - prevents data bleeding between accounts
    
    // User app data - protocols, vendors, orders, etc.
    match /userData/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Cloud backup snapshots (up to 3 per user)
      match /snapshots/{snapshotId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Data backup snapshots — written by dataBackup.js before destructive ops
    match /backups/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /snapshots/{snapshotId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // User preferences - theme, settings
    match /userPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User subscriptions - trial, paid plans
    // SECURITY: Users can read their own subscription but writes are restricted.
    // Cloud functions (Stripe webhooks via admin SDK) bypass these rules entirely.
    // Client writes are allowed for trial setup etc, but cannot self-promote to 'active'
    // or grant themselves lifetime access — only webhooks/admin can do that.
    match /userSubscriptions/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Allow create (initial trial setup) — but block hasLifetimeAccess: true
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.get('hasLifetimeAccess', false) == false
        && request.resource.data.get('status', '') != 'active';
      // Allow update — but cannot self-promote status to 'active' or grant lifetime access
      allow update: if request.auth != null && request.auth.uid == userId
        // Cannot grant self lifetime access (only admin SDK / webhooks can set this to true)
        && (request.resource.data.get('hasLifetimeAccess', false) == false
            || resource.data.get('hasLifetimeAccess', false) == true)
        // Cannot set status to 'active' unless it was already 'active' (only webhooks activate)
        && (request.resource.data.get('status', '') != 'active'
            || resource.data.get('status', '') == 'active');
    }
    
    // Sync error telemetry — client appends events; Cloud Functions / admins read
    // Path: syncErrors/{userId}/events/{eventId}
    match /syncErrors/{userId} {
      match /events/{eventId} {
        allow create: if request.auth != null && request.auth.uid == userId;
        allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      }
    }
    
    // collectionGroup read for admin panel Sync Error Monitor
    // collectionGroup('events') requires a wildcard path rule — nested match alone is not enough
    match /{path=**}/events/{eventId} {
      allow read: if isAdmin();
    }
    
    // User state - onboarding, demo flags
    match /userState/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User security settings - 2FA, authentication settings
    match /userSecurity/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Passkey credentials � server (Admin SDK) writes; users can only list/delete own via Cloud Functions.
    // Deny client direct writes; allow owner read for UI display if needed.
    match /passkeyCredentials/{credentialId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Short-lived WebAuthn challenges � Cloud Functions only
    match /passkeyChallenges/{challengeId} {
      allow read, write: if false;
    }
    
    // Lifetime access - admin can read/write all, users can read their own
    match /lifetimeAccess/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin()
      );
      allow write: if isAdmin(); // Only admin can grant lifetime access
    }
    
    // Lifetime access pre-grants - admin can read/write all, users can check their email
    match /lifetimeAccessPreGrants/{emailId} {
      allow read: if request.auth != null && (
        request.auth.token.email == emailId ||
        isAdmin()
      );
      allow write: if isAdmin(); // Only admin can create pre-grants
    }
    
    // Lifetime codes - redeemable codes from physical kits
    // get: allowed (code string IS the doc ID — only someone with the code can look it up)
    // list: admin only — prevents anyone from harvesting all unused codes
    match /lifetimeCodes/{codeId} {
      allow get: if true;
      allow list: if isAdmin();
      allow update: if request.auth != null; // Authenticated users can mark codes as used
      allow create, delete: if isAdmin(); // Only admin can create/delete codes
    }
    
    // Annual codes - redeemable codes from physical kits (1 year access)
    // get: allowed (code string IS the doc ID — only someone with the code can look it up)
    // list: admin only — prevents anyone from harvesting all unused codes
    match /annualCodes/{codeId} {
      allow get: if true;
      allow list: if isAdmin();
      allow update: if request.auth != null; // Authenticated users can mark codes as used
      allow create, delete: if isAdmin(); // Only admin can create/delete codes
    }
    
    // Config collection - admin can read/write; emailWhitelist and featureFlags are admin-only reads.
    // Any authenticated user can get a single config doc; listing the full collection is admin-only.
    match /config/{configId} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow write: if isAdmin(); // Only admin can write config
    }
    
    // App config - version info for update prompts (readable by all, writable by admin)
    match /appConfig/{configId} {
      allow read: if true; // Anyone can read version config (needed for update checks in app)
      allow write: if isAdmin(); // Only admin can write version config (via Admin panel)
    }
    
    // Version update history - admin only (tracks when version updates are sent)
    match /versionUpdateHistory/{historyId} {
      allow read, write: if isAdmin(); // Only admin can read/write version update history
    }
    
    // User agreements - users can create their own agreements, admin can read all
    match /user_agreements/{agreementId} {
      allow create: if request.auth != null; // Authenticated users can create agreements
      allow read: if request.auth != null && 
        (request.auth.token.email == resource.data.userEmail || isAdmin()); // Users can read their own, admin can read all
      allow update, delete: if false; // Agreements are immutable once created
    }
    
    // Notifications-enabled confirmation template — fired directly by the client (not via
    // Cloud Function) the instant any user grants notification permission, including
    // signed-out users on first app launch. Needs public read so that live edit picks up
    // for everyone; content is just non-sensitive marketing copy (title/body text).
    match /notificationTemplates/notificationsEnabledConfirmation {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Email templates - admin can manage. Cloud Functions use the Admin SDK (bypasses rules),
    // and the client only reads these from the admin panel — no public read needed.
    // FCM push templates — admin edits in Push Notifications panel; Functions read via Admin SDK
    match /notificationTemplates/{templateId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /emailTemplates/{templateId} {
      allow read: if isAdmin();
      allow write: if isAdmin(); // Only admin can modify email templates
    }
    
    // Email history - admin can read, cloud functions can write
    match /emailHistory/{emailId} {
      allow read: if isAdmin(); // Only admin can read email history
      allow write: if false; // Only cloud functions can write (they bypass rules)
    }
    
    // Contact form submissions - admin can read/update, cloud functions can write
    match /contactSubmissions/{submissionId} {
      allow read, update: if isAdmin(); // Admin can read and update (mark as read, add notes)
      allow create: if false; // Only cloud functions can create submissions (they bypass rules)
      allow delete: if isAdmin(); // Admin can delete old submissions
    }
    
    // Verification tokens - used for email verification.
    // Verification is performed entirely by Cloud Functions (Admin SDK, bypasses rules) via a
    // callable/HTTP endpoint — the client never reads this collection directly. Public read here
    // would let anyone list every pending verification token, userId, and email.
    match /verificationTokens/{tokenId} {
      allow read, write: if false; // Only server-side functions can access (they bypass rules)
    }
    
    // Announcement reaction counts — global, all authenticated users can read & write
    match /announcement_reactions/{postId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Per-user reaction choices — each user owns their own doc
    match /announcement_user_reactions/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Shop products - public can read active, admin can manage
    match /shopProducts/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /shopReviews/{reviewId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /shopReviewTokens/{tokenId} {
      allow read, write: if false;
    }

    match /shopReviewRequests/{requestId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /shopReviewRequestRate/{emailId} {
      allow read, write: if false;
    }
    
    // Physical store orders - admin can fully manage, public can read their own by sessionId
    // get: allowed (sessionId is the doc ID and acts as a secret token from Stripe)
    // list: admin only — prevents anyone from dumping all customer PII
    match /physicalOrders/{orderId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
    
    // Digital download tokens — Cloud Functions only (signed URLs)
    match /digitalDownloadTokens/{tokenId} {
      allow read, write: if false;
    }

    // Notify Me requests - anyone can sign up, Cloud Functions handle cleanup
    match /notifyMeRequests/{requestId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    // Shop inquiry forms (custom orders, wholesale, group discounts) - public create, admin read
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Shop marketing list — admin read; Cloud Functions write
    match /shopMarketingContacts/{contactId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    
    // Ghost Worker AI Automation - admin only
    match /_config/{configId} {
      allow read, write: if isAdmin(); // Only admin can access Ghost Worker config
    }

    match /_counters/{counterId} {
      allow read, write: if isAdmin();
    }
    
    match /ai_worker_logs/{logId} {
      allow read: if isAdmin(); // Only admin can read AI worker logs
      allow create: if false; // Only Cloud Functions create logs
      allow update: if isAdmin(); // Admin can mark responsePosted from work queue
      allow delete: if false;
    }
    
    match /ghostWorkerTests/{testId} {
      allow read: if isAdmin(); // Only admin can read test results
      allow write: if false; // Only Cloud Functions can write test results
    }
    
    match /ghostWorkerLogs/{logId} {
      allow read: if isAdmin(); // Only admin can read logs (legacy collection)
      allow write: if false; // Only Cloud Functions can write logs
    }
    
    // Account deletion requests - users can create their own requests, admin can read/update all
    match /accountDeletionRequests/{requestId} {
      allow create: if request.auth != null; // Authenticated users can submit deletion requests
      allow read, update: if isAdmin(); // Only admin can read and process deletion requests
      allow delete: if false; // Only cloud functions can delete (they bypass rules)
    }
    
    // Account deletions history - admin can read for audit trail
    match /accountDeletions/{deletionId} {
      allow read: if isAdmin(); // Only admin can read deletion history
      allow write: if false; // Only Cloud Functions can write deletion records
    }
    
    // PiP query log — Cloud Functions write (Admin SDK bypasses rules), admin reads
    match /pip_query_log/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // PiP research cache — Cloud Functions write, admin can read and delete entries
    match /pip_research_cache/{cacheId} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    // AI cost/quota collections — Cloud Functions write, admin reads for cost dashboard
    match /aiGlobalStats/{statId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /aiMonthlyUsage/{usageId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /aiQuota/{quotaId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /aiRateLimit/{limitId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /aiMigrationStats/{statId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Community Discover — approved vendors readable by anyone (web token page + in-app);
    // pending/rejected admin-only. Writes only via Cloud Functions.
    match /community_vendors/{vendorId} {
      allow read: if isAdmin()
        || (resource.data.status == 'approved');
      allow create, update, delete: if false;
    }

    match /community_vendor_votes/{voteId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /community_vendor_meta_votes/{voteId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /community_vendor_claims/{claimId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /_discover_tokens/{tokenId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
